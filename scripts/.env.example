SPREE_API_URL=http://localhost:4000
# Setup-only secret key (NOT the storefront's runtime key). Revoke after go-live.
#   npx @spree/cli api-key create --name seed --type secret \
#     --scopes write_settings,write_delivery_methods,write_products,read_all
SPREE_SEED_API_KEY=sk_replace_me
# Province your orders ship from. Decides whether MB RST / SK PST apply to shipping.
SHIP_FROM_PROVINCE=BC
# Store API key for pnpm verify:tax. Optional: defaults to SPREE_PUBLISHABLE_KEY in storefront/.env.local.
# SPREE_PUBLISHABLE_KEY=
