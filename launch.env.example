# ═══ Fill this ONCE, save as launch.env (gitignored). The agent reads it every phase. ═══
# Blank = the agent uses the fallback noted and flags it in its report.

# ── Phase 4: Google sign-in ──────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID → Web application.
# Authorized JavaScript origins: http://localhost:3001 (+ your staging/prod domains).
GOOGLE_CLIENT_ID=

# ── Phase 5: Stripe (TEST keys: dashboard.stripe.com/test/apikeys) ─────────
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Fallback if blank: phase 5 is skipped, everything else proceeds.

# ── Phase 2: tax ─────────────────────────────────────────────────────────────
# Province your orders ship from.
SHIP_FROM_PROVINCE=BC
# Provinces you're registered to collect PROVINCIAL tax in (comma list from BC,MB,QC,SK).
# Layers for unlisted provinces aren't charged. GST/HST is always charged.
# Fallback if blank: all four (staging only; fix before launch).
REGISTERED_PROVINCIAL=
# Accountant's answer on SK PST for supplements: taxable | exempt | unknown
SK_SUPPLEMENTS=unknown

# ── Phase 7: CASL ───────────────────────────────────────────────────────────
# Should the welcome-code email require ticking "Email me offers"? yes | no
# Fallback if blank: yes (the conservative choice).
WELCOME_EMAIL_REQUIRES_OPT_IN=yes
BUSINESS_LEGAL_NAME=
BUSINESS_MAILING_ADDRESS=
SUPPORT_EMAIL=

# ── Phase 8: staging (leave blank to stop after local; the agent writes exact steps) ─
STAGING_STOREFRONT_DOMAIN=
STAGING_API_DOMAIN=
RENDER_API_KEY=
VERCEL_TOKEN=
RESEND_API_KEY=

# ── Local models (free bulk work) ───────────────────────────────────────────
# Any OpenAI-compatible server: llama.cpp `--port 8080`, LM Studio, vLLM.
LOCAL_LLM_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=qwen-27b
# Optional small model for log summaries (4060 laptop). Blank = use the 27B.
LOCAL_LLM_SMALL_URL=
LOCAL_LLM_SMALL_MODEL=
