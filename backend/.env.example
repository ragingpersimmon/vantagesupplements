# ── Rails / Spree ─────────────────────────────────────────────
RAILS_ENV=development
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=replace_me_with_openssl_rand_hex_64
RAILS_HOST=localhost:4000
RAILS_FORCE_SSL=false
RAILS_ASSUME_SSL=false
# Run jobs in the separate `worker` service, not inside Puma
SOLID_QUEUE_IN_PUMA=false

# First admin account, minted by `spree seed`
ADMIN_EMAIL=admin@vantagesupplements.ca
ADMIN_PASSWORD=change_me_locally

POSTGRES_USER=spree
POSTGRES_PASSWORD=spree

# ── Google sign-in (verified by Vantage::GoogleIdTokenStrategy) ──
# Same OAuth Web client ID the storefront uses. No secret is needed here:
# the backend only verifies Google-signed ID tokens against this audience.
GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com

# ── Optional: Meilisearch (docker compose --profile search up) ──
MEILISEARCH_MASTER_KEY=dev_master_key_change_me
